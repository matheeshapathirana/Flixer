<?xml version="1.0" encoding="utf-8"?>
<!--
    This is the layout for the logout confirmation dialog.
    It uses a MaterialCardView to get that nice, modern, rounded look.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="32dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#25FFFFFF"
    app:strokeColor="#30FFFFFF"
    app:strokeWidth="1dp"
    android:layout_marginHorizontal="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- The title of the dialog. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- A message to the user, just to be sure. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Are you sure you want to logout from Flixer?"
            android:textColor="#80FFFFFF"
            android:textSize="16sp"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:layout_marginBottom="32dp" />

        <!-- A container for the two buttons. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- The cancel button, styled as an outlined button. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/ModernButtonStyle.Outline"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:layout_marginEnd="8dp"/>

            <!-- The logout button, with a more prominent style. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/ModernButtonStyle"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Logout"
                android:backgroundTint="@color/neon_pink"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
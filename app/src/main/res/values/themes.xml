<resources>

    <!-- The main theme for the app. -->
    <style name="Theme.Flixer" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Core Material color tokens -->
        <!-- Use crystal_blue as the main accent color -->
        <item name="colorPrimary">@color/crystal_blue</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>

        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>

        <item name="android:statusBarColor">@color/md_theme_primary</item>
        <item name="android:navigationBarColor">@color/md_theme_background</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_onError</item>

        <item name="android:windowBackground">@color/md_theme_background</item>
    </style>

    <!-- A separate theme for the authentication screens. -->
    <style name="Theme.Flixer.Auth" parent="Theme.Flixer">
        <item name="colorPrimary">@color/auth_primary</item>
        <item name="colorPrimaryVariant">@color/auth_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/auth_dark_bg</item>
        <item name="android:navigationBarColor">@color/auth_dark_bg</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Use Material background color for login pages -->
        <item name="android:windowBackground">@color/md_theme_background</item>
    </style>

    <!-- A custom style for the text input fields on the auth screens. -->
    <style name="AuthEditTextStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/auth_accent</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="hintTextColor">@color/auth_hint</item>
    </style>

    <!-- A more modern style for the text input fields. -->
    <style name="ModernInputStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <!-- A modern button style. -->
    <style name="ModernButtonStyle" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- A modern outlined button style. -->
    <style name="ModernButtonStyle.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/white</item>
    </style>

    <!-- A simple style for medium-weight text. -->
    <style name="MediumTextStyle">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Theme.Flixer.Splash" parent="Theme.Material3.Dark.NoActionBar">
        <item name="windowSplashScreenBackground">@color/md_theme_background</item>
    </style>

</resources>